# Frontend build-time config (Vite). Copy to .env for local overrides.

# Base URL the SPA calls. In dev, leave as /api/v1 and Vite proxies it to the
# backend (see vite.config.ts). For a standalone build against a remote API,
# set the full URL, e.g. https://api.example.com/api/v1
VITE_API_BASE_URL=/api/v1

# Where the dev-server proxy forwards /api (dev only).
VITE_API_PROXY=http://localhost:8000
