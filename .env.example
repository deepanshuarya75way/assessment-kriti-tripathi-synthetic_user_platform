# Copy to .env and adjust. Never commit your real .env.

# ---- environment ----
ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ---- security ----
# Generate a strong value:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-32-byte-random-secret-value-000000
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- database ----
# Local dev (zero setup): SQLite. Docker/compose uses PostgreSQL (set automatically there).
DATABASE_URL=sqlite:///./synthetic_research.db
# DATABASE_URL=postgresql+psycopg2://sur:sur_password@localhost:5432/synthetic_research

# ---- CORS (comma-separated browser origins allowed to call the API) ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- LLM provider ----
# 'fake'       -> deterministic offline provider, NO API key needed (great for demos/tests)
# 'openrouter' -> real OpenRouter (OpenAI-compatible) API; requires OPENROUTER_API_KEY
LLM_PROVIDER=fake
OPENROUTER_API_KEY=
# Optional: pin a model tried first (else the auto-router 'openrouter/free' is used)
MODEL_NAME=
FALLBACK_MODEL=openrouter/free

# ---- cost / abuse controls ----
MAX_PERSONAS=10
MAX_QUESTIONS=15
MAX_INPUT_CHARS=4000
